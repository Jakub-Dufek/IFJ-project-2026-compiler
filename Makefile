#		.PHONY
.PHONY: all pack clean help test-err test-scan test-ast1

#		FLAGS
CC = gcc
CFLAGS = -Isrc -MMD -MP
CFLAGS+ = -Isrc -MMD -MP -pedantic -Wall -Wextra

# The two lines below were generated by Gemini flash 3.8
# Prompt:  "build/compiler: build/ast.o build/error.o build/expr_parser.o build/parser.o build/scanner.o build/symtable.o build/main.o
#				$(CC) $(CFLAGS) $^ -o $@
#			je možné to nějak zkrátit?"
SRCS = $(wildcard src/*.c)
OBJS = $(patsubst src/%.c, build/%.o, $(SRCS))


#		MAIN COMMANDS
all: build/compiler

clean:
	rm -rf build/

help:
	@echo ==================== HELP ====================
	@echo make all 			- Compiles entire project
	@echo make clean 		- Removes build/
	@echo make help			- Shows help feed
	@echo 
	@echo make test-err		- Tests error handling
	@echo make test-scan	- Tests scanner module
	@echo make test-ast1	- Tests ast insert module
	@echo ==================== HELP ====================


#		TEST COMMANDS
test-err: build/err_test.o build/error.o
	$(CC) $(CFLAGS+) $^ -o build/err_test
	-./build/err_test

test-scan: build/scanner_test.o build/scanner.o build/error.o build/memory.o
	$(CC) $(CFLAGS+) $^ -o build/scanner_test
	-./build/scanner_test

test-ast1: build/ast_test1.o build/ast.o build/semantic_anal.o build/symtable.o build/error.o build/memory.o
	$(CC) $(CFLAGS+) $^ -o build/ast_test1
	./build/ast_test1


#		RULES
build/%.o: src/%.c | build
	$(CC) $(CFLAGS) -c $< -o $@

build/%.o: tests/%.c | build
	$(CC) $(CFLAGS+) -c $< -o $@


#		DEPENDENCIES
build:
	mkdir -p build/

build/compiler: $(OBJS)
	$(CC) $(CFLAGS) $^ -o $@


#		HEADER FILE UPDATE HANDLING
-include build/*.d
